# Copy to .env.local and fill in. On Vercel, set these in Project → Settings → Environment Variables.

# Clerk — personal accounts (in the Clerk dashboard, keep Organizations disabled)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# PostgreSQL (Neon via the Vercel Marketplace). Run `npm run db:migrate` once.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Resend — result emails and expert consultation requests (optional; skipped if unset)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="GrowTern <noreply@yourdomain.com>"

# Vercel Blob — shareable HTML competency reports (optional). Create a PUBLIC store.
# On Vercel, connecting the store adds BLOB_STORE_ID (OIDC auth) automatically.
# For local dev, `vercel env pull` brings it in, or set a read-write token:
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Used for links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
